---
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { Icon } from "astro-icon/components";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const innovations = [
  {
    icon: "mdi:lightbulb-on-outline",
    titleKey: "about.innovation.mentorship.title",
    contentKey: "about.innovation.mentorship.content",
  },
  {
    icon: "mdi:language-typescript", // Placeholder, consider a more generic design/spec icon
    titleKey: "about.innovation.uisl.title",
    contentKey: "about.innovation.uisl.content",
  },
  {
    icon: "mdi:creation", // Placeholder, consider a more generic AI/automation icon
    titleKey: "about.innovation.cva.title",
    contentKey: "about.innovation.cva.content",
  },
];
---

<section id="about" class="section about-section py-20 lg:py-32 bg-gradient-to-br from-slate-900 to-zinc-900 text-white">
  <div class="col-span-12 container mx-auto px-6 max-w-7xl">
    <div class="text-center mb-16 lg:mb-24">
      <h2 class="text-4xl lg:text-5xl font-bold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-primary-400 via-secondary-400 to-accent-400 mb-4">
        {t("about.title")}
      </h2>
      <p class="text-xl lg:text-2xl text-slate-300 max-w-3xl mx-auto">
        {t("about.subtitle")}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-20 items-center mb-16 lg:mb-24">
      <div class="prose prose-lg prose-invert max-w-none">
        <h3 class="text-3xl font-semibold text-primary-300 !mb-3">{t("about.story.title")}</h3>
        <p class="text-slate-300">
          {t("about.story.content")}
        </p>
      </div>
      <div class="prose prose-lg prose-invert max-w-none">
        <h3 class="text-3xl font-semibold text-secondary-300 !mb-3">{t("about.approach.title")}</h3>
        <p class="text-slate-300">
          {t("about.approach.content")}
        </p>
      </div>
    </div>

    <div class="text-center mb-12 lg:mb-16">
      <h3 class="text-3xl lg:text-4xl font-bold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-primary-400 via-secondary-400 to-accent-400">
        {t("about.innovation.title")}
      </h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
      {innovations.map((item) => (
        <div class="bg-slate-800/50 p-6 lg:p-8 rounded-xl shadow-xl hover:shadow-primary-500/30 transition-shadow duration-300 ease-in-out transform hover:-translate-y-1">
          <div class="flex items-center text-primary-400 mb-4">
            <Icon name={item.icon} class="h-10 w-10 mr-4" />
            <h4 class="text-xl lg:text-2xl font-semibold text-slate-100">{t(item.titleKey)}</h4>
          </div>
          <p class="text-slate-300 text-base lg:text-lg">
            {t(item.contentKey)}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .prose-invert h3 {
    @apply !mt-0; /* Overriding prose default margin */
  }
  .prose-invert p {
    @apply text-slate-300;
  }
</style> 