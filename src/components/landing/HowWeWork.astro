---
import { getLangFromUrl, useTranslations, useTranslatedPath } from "@i18n/utils";
import { Icon } from "astro-icon/components";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const benefits = [
  {
    icon: "mdi:rocket-launch-outline",
    titleKey: "howWeWork.benefits.b1.title",
    contentKey: "howWeWork.benefits.b1.content",
  },
  {
    icon: "mdi:cash-multiple",
    titleKey: "howWeWork.benefits.b2.title",
    contentKey: "howWeWork.benefits.b2.content",
  },
  {
    icon: "mdi:target-arrow",
    titleKey: "howWeWork.benefits.b3.title",
    contentKey: "howWeWork.benefits.b3.content",
  },
  {
    icon: "mdi:account-group-outline",
    titleKey: "howWeWork.benefits.b4.title",
    contentKey: "howWeWork.benefits.b4.content",
  },
];

const processSteps = [
  { titleKey: "howWeWork.process.s1.title", contentKey: "howWeWork.process.s1.content", icon: "mdi:ear-hearing" },
  { titleKey: "howWeWork.process.s2.title", contentKey: "howWeWork.process.s2.content", icon: "mdi:magnify-expand" },
  { titleKey: "howWeWork.process.s3.title", contentKey: "howWeWork.process.s3.content", icon: "mdi:checkbox-marked-circle-outline" },
  { titleKey: "howWeWork.process.s4.title", contentKey: "howWeWork.process.s4.content", icon: "mdi:cogs" },
];

const cartoonFrames = [
    { titleKey: "howWeWork.cartoon.f1.title", captionKey: "howWeWork.cartoon.f1.caption", descKey: "howWeWork.cartoon.f1.desc" },
    { titleKey: "howWeWork.cartoon.f2.title", captionKey: "howWeWork.cartoon.f2.caption", descKey: "howWeWork.cartoon.f2.desc" },
    { titleKey: "howWeWork.cartoon.f3.title", captionKey: "howWeWork.cartoon.f3.caption", descKey: "howWeWork.cartoon.f3.desc" },
    { titleKey: "howWeWork.cartoon.f4.title", captionKey: "howWeWork.cartoon.f4.caption", descKey: "howWeWork.cartoon.f4.desc" },
];
---
<section id="how-we-work" class="section how-we-work-section py-20 lg:py-32 bg-slate-50 text-slate-800">
  <div class="col-span-12 container mx-auto px-6 max-w-7xl">
    <!-- Main Title -->
    <div class="text-center mb-16 lg:mb-24">
      <h2 class="text-4xl lg:text-5xl font-bold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-primary-600 via-secondary-500 to-accent-500 mb-4">
        {t("howWeWork.title")}
      </h2>
    </div>

    <!-- Headline & Body -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center mb-16 lg:mb-24">
      <div class="prose prose-lg max-w-none text-slate-700">
        <h3 class="text-3xl font-semibold !text-slate-800 !mb-3">{t("howWeWork.headline")}</h3>
        <p class="text-xl text-slate-600 italic mb-6">{t("howWeWork.subheadline")}</p>
        <p>{t("howWeWork.body.p1")}</p>
        <p>{t("howWeWork.body.p2")}</p>
        <p>{t("howWeWork.body.p3")}</p>
      </div>
      <div class="prose prose-lg max-w-none text-slate-700">
        <p>{t("howWeWork.body.p4")}</p>
        <p class="font-semibold text-slate-800">{t("howWeWork.body.p5")}</p>
      </div>
    </div>

    <!-- Benefits -->
    <div class="mb-16 lg:mb-24">
      <h3 class="text-3xl lg:text-4xl font-semibold text-center text-slate-800 mb-12 lg:mb-16">{t("howWeWork.benefits.title")}</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {benefits.map(benefit => (
          <div class="bg-white p-6 rounded-lg shadow-lg hover:shadow-primary-500/20 transition-shadow duration-300 ease-in-out">
            <Icon name={benefit.icon} class="h-12 w-12 text-primary-500 mb-4" />
            <h4 class="text-xl font-semibold text-slate-800 mb-2">{t(benefit.titleKey)}</h4>
            <p class="text-slate-600">{t(benefit.contentKey)}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Tree Swing Cartoon (Textual Representation) -->
    <div class="mb-16 lg:mb-24 bg-gradient-to-r from-slate-100 to-slate-200 p-8 lg:p-12 rounded-lg shadow-inner">
      <h3 class="text-3xl lg:text-4xl font-semibold text-center text-slate-800 mb-12">{t("howWeWork.cartoon.title")}</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {cartoonFrames.map((frame, index) => (
          <div class="border border-slate-300 p-6 rounded-md bg-white/50 shadow-sm">
            <h4 class="text-xl font-semibold text-primary-600 mb-2">{t(frame.titleKey)}</h4>
            <p class="text-slate-700 font-medium italic mb-1">{t(frame.captionKey)}</p>
            <p class="text-sm text-slate-500">{t(frame.descKey)}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Process Steps -->
    <div class="mb-16 lg:mb-24">
      <h3 class="text-3xl lg:text-4xl font-semibold text-center text-slate-800 mb-12 lg:mb-16">{t("howWeWork.process.title")}</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {processSteps.map(step => (
          <div class="flex flex-col items-center text-center p-6 bg-white rounded-lg shadow-md hover:shadow-secondary-500/20 transition-shadow duration-300 ease-in-out">
            <Icon name={step.icon} class="h-16 w-16 text-secondary-500 mb-4" />
            <h4 class="text-xl font-semibold text-slate-800 mb-2">{t(step.titleKey)}</h4>
            <p class="text-slate-600">{t(step.contentKey)}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Client Story Example -->
    <div class="bg-primary-500 text-white p-8 lg:p-12 rounded-lg shadow-xl mb-16 lg:mb-24">
      <h3 class="text-3xl lg:text-4xl font-semibold text-center mb-8">{t("howWeWork.story.title")}</h3>
      <div class="prose prose-lg prose-invert max-w-3xl mx-auto text-center">
        <p class="font-semibold">{t("howWeWork.story.challenge")}</p>
        <p>{t("howWeWork.story.approach")}</p>
        <p class="font-bold text-xl">{t("howWeWork.story.result")}</p>
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center">
      <h3 class="text-2xl lg:text-3xl font-semibold text-slate-800 mb-6">{t("howWeWork.cta.title")}</h3>
      <a href={translatePath("/contact")} class="inline-block bg-gradient-to-r from-primary-500 to-secondary-500 hover:from-primary-600 hover:to-secondary-600 text-white font-semibold py-4 px-10 rounded-lg text-lg shadow-md hover:shadow-lg transition-all duration-300 ease-in-out transform hover:scale-105">
        {t("howWeWork.cta.button")}
        <Icon name="mdi:arrow-right" class="inline-block h-6 w-6 ml-2" />
      </a>
    </div>

  </div>
</section>

<style>
  .prose h3 {
    @apply text-slate-800;
  }
  .prose p, .prose ul {
    @apply text-slate-700;
  }
  .prose-invert p, .prose-invert ul {
    @apply !text-primary-100; /* Ensure client story text is light on dark bg */
  }
   .prose-invert .font-semibold {
    @apply !text-white;
  }
  .prose-invert .font-bold {
    @apply !text-white;
  }
</style> 