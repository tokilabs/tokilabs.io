---
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const { image, project, link, description, class: className } = Astro.props;
---

<li class:list={["flex flex-col bg-white rounded-lg overflow-hidden shadow-md", className]}>
	<a href={translatePath(link)} aria-label={`Project ${project}`} class="p-4 block">
		<Image class="w-full h-64 project-logo-image" src={image} alt={project} />
	</a>
	<div class="p-6">
		<a href={translatePath(link)} class="flex items-center justify-between text-base font-medium lg:gap-x-8">
			<h3 class="font-mono text-lg font-medium uppercase tracking-wide md:mt-0 lg:text-xl">
				{project}
			</h3>
			<span class="text-right text-base hover:text-primary-700">
				<span class="hidden lg:inline-block">{t("projects.see")}</span>
				<span class="sr-only">{project}</span> &nbsp; &rarr;
			</span>
		</a>
		{description && <p class="mt-4 line-clamp-3 text-sm text-slate-500">{description}</p>}
	</div>
</li>

<style>
	.project-logo-image {
		object-fit: contain; /* or scale-down */
		/* You might also want to set a background color if images have transparency and padding */
		/* background-color: #f0f0f0; */ 
	}
</style>
