---
import BlobCursorFollower from "@/components/global/BlobCursorFollower.astro";
import { AstroSeo, type AstroSeoProps } from "@astrolib/seo";
import BaseHead from "@components/BaseHead.astro";
import BackgroundTexture from "@components/global/BackgroundTexture.astro";
import Footer from "@components/global/Footer.astro";
import Navigation from "@components/global/Navigation.astro";
import { getLangFromUrl } from "../i18n/utils";

const { pathname } = Astro.url;

type Props = {
	seo?: AstroSeoProps;
};

const { seo: seoProp } = Astro.props;

const lang = getLangFromUrl(Astro.url);

const shareImage = new URL("/images/meta/majestico_share.gif", Astro.site).toString();

const defaultSeo: AstroSeoProps = {
	title: "Toki Labs - Software House That Works Differently | 21+ Years of Excellence",
	description:
		"We don't just build what you ask for. We partner with you to discover what you actually need. 21+ years of experience in complex system architecture, team building, and technical leadership.",
	canonical: "https://tokilabs.io",
	openGraph: {
		url: "https://tokilabs.io",
		title: "Toki Labs - Software House That Works Differently",
		description:
			"Instead of developing for clients, we seek and support partners. We thrive in complexity where others see chaos, delivering technology solutions that create positive change.",
		images: [
			{
				url: shareImage,
				width: 1200,
				height: 630,
				alt: "Toki Labs - Software Factory",
				type: "image/gif",
			},
			{
				url: shareImage,
				width: 4096,
				height: 4096,
				alt: "Toki Labs - Software Factory",
				type: "image/gif",
			},
		],
		site_name: "Toki Labs",
	},
	twitter: {
		handle: "@svallory",
		site: "@svallory",
		cardType: "summary_large_image",
	},
	additionalMetaTags: [
		{
			name: "publisher",
			content: "Toki Labs",
		},
	],
};

const seo = {
	...defaultSeo,
	...seoProp,
};

function cursorFollowerActive() {
	const paths = ["", "/", "/it/", "/it"];
	return paths.includes(pathname);
}
---

<html lang={lang}>
	<head>
		<BaseHead />
		<AstroSeo {...seo} />
	</head>
	<body class="bg-slate-50">
		<BackgroundTexture />
		<Navigation />
		{cursorFollowerActive() && <BlobCursorFollower />}
		<slot />
		<Footer />
	</body>
</html>
