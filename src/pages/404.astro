---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";
import Error404 from "@components/infopages/Error404.astro";

const seo: AstroSeoProps = {
	title: "404 Error: Page Not Found - Toki Labs",
	description:
		"Oops! The page you're looking for doesn't exist. Navigate back to Toki Labs' homepage for our full range of software development services.",
	canonical: "https://tokilabs.io/404/",
};
---

<BaseLayout seo={seo}>
	<Error404 />
</BaseLayout>
