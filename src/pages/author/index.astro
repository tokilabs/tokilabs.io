---
import { getCollection } from "astro:content";
import type { AstroSeoProps } from "@astrolib/seo";
import Authors from "@components/blog/Authors.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

const allAuthors = await getCollection("authors");
const pageTitle = "Authors";

const seo: AstroSeoProps = {
	title: "Authors - Meet the Toki Labs Team",
	description:
		"Meet the experienced software architects and technical leaders behind Toki Labs. Expert insights from 21+ years of solving complex technology challenges.",
	canonical: "https://tokilabs.io/author/",
};
---

<BaseLayout seo={seo}>
	<Authors />
</BaseLayout>
