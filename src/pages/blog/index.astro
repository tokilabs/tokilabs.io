---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";
import Articles from "@components/blog/Articles.astro";

const seo: AstroSeoProps = {
	title: "Toki Labs Blog: Insights on Software Architecture and Technical Leadership",
	description:
		"Expert insights on complex system architecture, technical leadership, and software development best practices from Toki Labs' 21+ years of experience.",
	canonical: "https://tokilabs.io/blog/",
	openGraph: {
		url: "https://tokilabs.io/blog",
		title: "Toki Labs Blog: Insights on Software Architecture and Technical Leadership",
		description:
			"Expert insights on complex system architecture, technical leadership, and software development best practices from experienced practitioners.",
		images: [
			{
				url: "https://tokilabs.io/images/meta/majestico_share.gif",
				width: 1200,
				height: 630,
				alt: "Toki Labs - Software Factory",
				type: "image/gif",
			},
		],
		site_name: "Toki Labs",
	},
	twitter: {
		handle: "@svallory",
		site: "@svallory",
		cardType: "summary_large_image",
	},
};
---

<BaseLayout seo={seo}>
	<Articles />
</BaseLayout>
