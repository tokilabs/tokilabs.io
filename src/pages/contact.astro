---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";
import Contact from "@components/forms/Contact.astro";

const seo: AstroSeoProps = {
	title: "Contact Toki Labs: Let's Start a Partnership Conversation",
	description:
		"Ready to discover what you actually need? Connect with Toki Labs to discuss your next complex software challenge and explore innovative solutions.",
	canonical: "https://tokilabs.io/contact/",
};
---

<BaseLayout seo={seo}>
	<Contact />
</BaseLayout>
