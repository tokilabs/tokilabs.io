---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";
import Privacy from "@components/infopages/Privacy.astro";

const seo: AstroSeoProps = {
	title: "Privacy Policy - Toki Labs: Your Privacy Matters",
	description:
		"Our Privacy Policy outlines how Toki Labs protects your personal information. Discover our commitment to your privacy and data security.",
	canonical: "https://tokilabs.io/privacy/",
};
---

<BaseLayout seo={seo}>
	<Privacy />
</BaseLayout>
