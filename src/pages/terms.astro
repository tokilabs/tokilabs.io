---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";
import Terms from "@components/infopages/Terms.astro";

const seo: AstroSeoProps = {
	title: "Terms of Service - Toki Labs: Understand Our Terms",
	description:
		"Read the Terms of Service for Toki Labs. Learn about our guidelines and your responsibilities when partnering with our software development services.",
	canonical: "https://tokilabs.io/terms/",
};
---

<BaseLayout seo={seo}>
	<Terms />
</BaseLayout>
