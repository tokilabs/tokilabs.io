---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";
import ThankYou from "@components/infopages/ThankYou.astro";

const seo: AstroSeoProps = {
	title: "Thank You - Toki Labs: Partnership Inquiry Received",
	description:
		"Thank you for reaching out to Toki Labs! Your partnership inquiry has been successfully sent. We appreciate your interest and will respond promptly to discuss your project.",
	canonical: "https://tokilabs.io/thank-you/",
};
---

<BaseLayout seo={seo}>
	<ThankYou />
</BaseLayout>
