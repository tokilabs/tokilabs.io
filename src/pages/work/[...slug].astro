---
import { getCollection } from "astro:content";
import type { AstroSeoProps } from "@astrolib/seo";
import MarkdownPostLayout from "../../layouts/ProjectLayout.astro";

export async function getStaticPaths() {
	const projectsEntries = await getCollection("projects");

	return projectsEntries
		.map((entry) => {
			const [lang, ...slug] = entry.slug.split("/");
			return { params: { lang, slug: slug.join("/") || undefined }, props: entry };
		})
		.filter((entry) => entry.params.lang === "en");
}

const entry = Astro.props;
const { Content } = await entry.render();

const seo: AstroSeoProps = {
	title: `${entry.data.title} | Toki Labs`,
	description: entry.data.description,
	canonical: `https://tokilabs.io/work/${entry.slug}/`,
	openGraph: {
		url: `https://tokilabs.io/work/${entry.slug}/`,
		title: entry.data.title,
		description: entry.data.description,
		images: [
			{
				url: "https://tokilabs.io/images/meta/majestico_share.gif",
				width: 1200,
				height: 630,
				alt: "Toki Labs - Software Factory",
				type: "image/gif",
			},
		],
		site_name: "Toki Labs",
	},
	twitter: {
		handle: "@svallory",
		site: "@svallory",
		cardType: "summary_large_image",
	},
};
---

<MarkdownPostLayout frontmatter={entry.data} body={entry.body} seo={seo}>
	<Content />
</MarkdownPostLayout>
